# ==============================================================================
# POC SMART SEARCH - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and adjust variables as needed:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVICE PORTS & NETWORKING
# ------------------------------------------------------------------------------
# Port for Mock Core Education App (External host service)
APP_PORT=3000

# Port for Smart Search Engine Service
SEARCH_PORT=4000

# Base URL to app-education service (used by service-search)
APP_EDUCATION_URL=http://127.0.0.1:3000

# Base URL to service-search (used by app-education for proxy / sync)
SEARCH_SERVICE_URL=http://127.0.0.1:4000

# ------------------------------------------------------------------------------
# 2. REDIS CACHE
# ------------------------------------------------------------------------------
# Redis connection string for Query Cache & Master Data Lazy Cache
REDIS_URL=redis://127.0.0.1:6379

# TTL for Master Data Cache (academic years, classes, subjects) in seconds (default: 30 mins)
SMARTSEARCH_MASTER_TTL=1800

# Optional comma-separated pre-warm manifest list on startup: "client_id:role,client_id:role"
SMARTSEARCH_WARMUP=1:SUPERADMIN,1:GURU

# ------------------------------------------------------------------------------
# 3. AI ENGINES & CLASSIFIER
# ------------------------------------------------------------------------------
# Default search engine: "jev" (TypeSafe JEV Cloud) or "local" (Transformers.js in-process)
SEARCH_ENGINE=jev

# TypeSafe API Key for JEV Cloud System One classification
# Get your key from: https://api.typesafe.ai
TYPESAFE_API_KEY=your_typesafe_api_key_here

# ------------------------------------------------------------------------------
# 4. IN-PROCESS LOCAL MODEL (Transformers.js / ONNX)
# ------------------------------------------------------------------------------
# Local model ID for fallback classification and semantic enum matching
LOCAL_MODEL_ID=Xenova/multilingual-e5-small

# Quantization dtype: "q8" (recommended), "q4", "fp16", or "fp32"
LOCAL_MODEL_DTYPE=q8

# Path to pre-baked local model weights
LOCAL_MODEL_PATH=./models

# Cache directory for HuggingFace downloads (when remote allowed)
HF_HOME=./.cache

# Allow downloading model from remote HuggingFace Hub (set to "false" in offline/Docker prod)
HF_ALLOW_REMOTE=true

# ------------------------------------------------------------------------------
# 5. LOGGING, AI TRACE & DEBUGGING
# ------------------------------------------------------------------------------
# Log verbosity level in terminal:
# - "normal" : Clean one-line summary per query (Production default)
# - "dev"    : Deep inspection trace detailing Step 1 to 4 with timings & models
# - "off"    : Mute all search pipeline logs
SMART_SEARCH_LOG_LEVEL=normal

# Attach detailed "debug_trace" JSON object to /resolve HTTP response
# Can also be dynamically activated per-request via "X-Debug: true" HTTP header
DEBUG_AI_TRACE=true
